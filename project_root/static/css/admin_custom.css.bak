/* project_root/static/css/admin_custom.css */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

:root {
    /* PRISMA Colors - Light Mode */
    --p-azul-escuro: #1e3a5f;
    --p-azul-medio: #1e4e8c;
    --p-amarelo: #ffb800;
    --p-bg: #f8fafc;
    --p-card-bg: #ffffff;
    --p-border: #e2e8f0;
    --p-text-main: #334155;
    --p-text-muted: #64748b;
    --p-header-bg: #1e3a5f;
}

@media (prefers-color-scheme: dark) {
    :root {
        /* PRISMA Colors - Dark Mode */
        --p-bg: #0f172a;
        --p-card-bg: #1e293b;
        --p-border: #334155;
        --p-text-main: #f1f5f9;
        --p-text-muted: #94a3b8;
        --p-header-bg: #020617;
    }
}

/* Base Overrides */
body {
    font-family: 'Inter', sans-serif !important;
    background-color: var(--p-bg) !important;
    color: var(--p-text-main) !important;
}

h1, h2, h3, h4, h5, h6 {
    font-family: 'Myriad Pro', 'Inter', sans-serif !important;
}

/* Header & Nav */
#header {
    background: var(--p-header-bg) !important;
    border-bottom: 2px solid var(--p-amarelo) !important;
    padding: 0.75rem 2rem !important;
    height: auto !important;
}

#branding h1 {
    color: white !important;
    font-weight: 900 !important;
    font-size: 1.1rem !important;
    text-transform: uppercase;
    letter-spacing: -0.02em;
}

#user-tools {
    color: #cbd5e1 !important;
    font-weight: 600 !important;
    font-size: 0.75rem !important;
}

#user-tools a {
    color: white !important;
    border-bottom: 1px solid transparent;
    transition: all 0.2s;
}

#user-tools a:hover {
    color: var(--p-amarelo) !important;
    border-bottom-color: var(--p-amarelo);
}

/* Breadcrumbs */
.breadcrumbs {
    background: var(--p-card-bg) !important;
    border-bottom: 1px solid var(--p-border) !important;
    padding: 0.75rem 2rem !important;
    font-size: 0.75rem !important;
    font-weight: 600 !important;
    color: var(--p-text-muted) !important;
}

.breadcrumbs a {
    color: var(--p-azul-medio) !important;
}

/* Index Modules (Cards) */
.module {
    background: var(--p-card-bg) !important;
    border: 1px solid var(--p-border) !important;
    border-radius: 1rem !important;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05) !important;
    margin-bottom: 1.5rem !important;
    overflow: hidden !important;
}

.module caption, .module h2 {
    background: var(--p-azul-escuro) !important;
    color: white !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    font-size: 0.7rem !important;
    padding: 0.75rem 1rem !important;
}

.module table {
    width: 100% !important;
}

.module table tr th, .module table tr td {
    padding: 0.75rem 1rem !important;
    border-bottom: 1px solid var(--p-border) !important;
}

.module table tr:last-child th, .module table tr:last-child td {
    border-bottom: none !important;
}

/* Changelist Table */
#changelist table {
    border-collapse: separate !important;
    border-spacing: 0 !important;
    border: 1px solid var(--p-border) !important;
    border-radius: 0.75rem !important;
}

#changelist table thead th {
    background: var(--p-bg) !important;
    color: var(--p-text-muted) !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    font-size: 0.65rem !important;
    border-bottom: 2px solid var(--p-border) !important;
}

/* Form Fields */
input[type=text], input[type=password], input[type=email], select, textarea {
    background-color: var(--p-card-bg) !important;
    border: 1px solid var(--p-border) !important;
    border-radius: 0.5rem !important;
    color: var(--p-text-main) !important;
    padding: 0.5rem 0.75rem !important;
}

input:focus, select:focus {
    border-color: var(--p-azul-medio) !important;
    box-shadow: 0 0 0 3px rgba(30, 78, 140, 0.2) !important;
    outline: none !important;
}

/* Buttons */
.button, input[type=submit], .submit-row input, .deletelink {
    background: var(--p-azul-escuro) !important;
    color: white !important;
    border-radius: 0.5rem !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    font-size: 0.75rem !important;
    padding: 0.6rem 1.2rem !important;
    border: none !important;
    transition: all 0.2s !important;
    cursor: pointer !important;
}

.button:hover, input[type=submit]:hover {
    background: var(--p-azul-medio) !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
}

.button.default, input[type=submit].default {
    background: var(--p-amarelo) !important;
    color: #1e3a5f !important;
}

.button.default:hover {
    background: #e6a600 !important;
}

.deletelink {
    background: #ef4444 !important;
}

.deletelink:hover {
    background: #dc2626 !important;
}

/* Dashboard Grid */
#content-main {
    display: grid !important;
    grid-template-cols: repeat(auto-fill, minmax(320px, 1fr)) !important;
    gap: 1.5rem !important;
}

/* Transitions */
* {
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
}

/* Dark Mode Specific Overrides for Django native elements */
.theme-dark body {
    --p-bg: #0f172a;
    --p-card-bg: #1e293b;
    --p-border: #334155;
    --p-text-main: #f1f5f9;
    --p-text-muted: #94a3b8;
    --p-header-bg: #020617;
}

.theme-dark #header {
    background: var(--p-header-bg) !important;
}

.theme-dark .module caption {
    background: #334155 !important;
}

/* Custom Notification Style in Admin */
#adminNotificationMenu {
    background: var(--p-card-bg) !important;
    border-color: var(--p-border) !important;
    color: var(--p-text-main) !important;
}

#adminNotificationMenu .bg-slate-50 {
    background: var(--p-bg) !important;
}
