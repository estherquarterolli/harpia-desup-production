# ----------- DJANGO SETTINGS ----------
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Senha padrão aplicada em resets e criação de usuários (deve ser trocada no primeiro login)
DEFAULT_USER_PASSWORD=Faetec@123

# ----------- DATABASE SETTINGS (LOCAL DEV) -----------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=allocgest_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ----------- PRODUÇÃO: SUPABASE -----------
# Use DATABASE_URL em produção (Render.com)
# Formato: postgresql://user:password@db.supabase.co:5432/postgres
DATABASE_URL=

# Credenciais Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=xxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# Storage
SUPABASE_STORAGE_BUCKET=allocgest-storage

# ----------- REDIS (OPTIONAL) -----------
REDIS_URL=redis://localhost:6379/0

# ----------- EMAIL -----------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-app
EMAIL_USE_TLS=True

# ----------- CELERY -----------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
