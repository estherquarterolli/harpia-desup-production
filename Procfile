release: cd project_root && DJANGO_SETTINGS_MODULE=config.settings.production python manage.py migrate && DJANGO_SETTINGS_MODULE=config.settings.production python manage.py collectstatic --noinput
web: cd project_root && DJANGO_SETTINGS_MODULE=config.settings.production gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers ${WEB_CONCURRENCY:-3} --threads 4 --worker-class gthread --timeout 120 --keep-alive 5
